# Local runtime config loaded by `app` at startup.
# Copy to `.env` and adjust local paths as needed.

# Optional: pin the Codex executable used by the app.
# Quote Windows paths and escape backslashes.
# CODEX_CLI_PATH="C:\\Users\\cyril\\AppData\\Roaming\\npm\\codex.exe"

# Optional: keep Cargo verification/build output out of `target`.
# Cargo itself does not read this file; use `cargo test --target-dir .target-verify`
# when running Cargo directly from the shell.
CARGO_TARGET_DIR=.target-verify
