{
  "defaults": {
    "model": null,
    "reasoning": null,
    "timeout_seconds": 3600
  },
  "steps": [
    {
      "name": "audit",
      "rust_command": ["audit", "--target", "{target}"],
      "model": "gpt-5.4",
      "reasoning": "medium",
      "fresh_codex_call": true
    },
    {
      "name": "plan",
      "rust_command": ["plan", "{artifact:audit}"],
      "model": "gpt-5.4",
      "reasoning": "medium",
      "fresh_codex_call": true
    },
    {
      "name": "implementation",
      "rust_command": [
        "--mode",
        "exec",
        "Use $rust-dev-solid to implement the refactoring plan at {artifact:plan} for {target}. Initial prompt: {initial_prompt}. Apply the scoped Rust changes, preserve unrelated user changes, and run the relevant verification commands before finishing."
      ],
      "model": "gpt-5.4-mini",
      "reasoning": "low",
      "fresh_codex_call": false
    },
    {
      "name": "dev_review_corrections",
      "rust_command": ["fix-loop", "implementation", "{target}"],
      "model": "gpt-5.4",
      "reasoning": "medium",
      "fresh_codex_call": true
    },
    {
      "name": "alignment_audit",
      "rust_command": ["implementation-audit", "{artifact:plan}", "--implementation", "{target}"],
      "model": null,
      "reasoning": null,
      "fresh_codex_call": true
    },
    {
      "name": "alignment_corrections",
      "rust_command": ["fix-loop", "audit", "{artifact:alignment_audit}"],
      "model": null,
      "reasoning": null,
      "fresh_codex_call": false
    },
    {
      "name": "commit_push",
      "rust_command": [
        "--mode",
        "exec",
        "Commit and push the refactoring work for {target}. Initial prompt: {initial_prompt}. Use a concise commit message, preserve unrelated user changes, and report any push blocker."
      ],
      "model": "gpt-5.4-mini",
      "reasoning": "low",
      "fresh_codex_call": true
    }
  ],
  "loop_policy": {
    "audit_step": "alignment_audit",
    "max_cycles": 1,
    "clean_markers": [
      "no actionable findings",
      "aucun finding actionnable",
      "aucune correction requise",
      "no findings"
    ]
  }
}
